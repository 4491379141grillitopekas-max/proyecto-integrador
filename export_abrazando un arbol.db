BEGIN TRANSACTION;
CREATE TABLE IF NOT EXISTS beneficiario (id_beneficiario INTEGER PRIMARY KEY AUTOINCREMENT, nombre TEXT NOT NULL, direccion TEXT, telefono TEXT,
id_planta TEXT REFERENCES planta(id_planta));
CREATE TABLE IF NOT EXISTS institucion (id_institucion INTEGER PRIMARY KEY AUTOINCREMENT, nombre TEXT NOT NULL, direccion TEXT, telefono TEXT,
id_beneficiario INTEGER,FOREIGN KEY (id_beneficiario) REFERENCES beneficiario(id_beneficiario));
CREATE TABLE IF NOT EXISTS planta (id_planta INTEGER PRIMARY KEY AUTOINCREMENT, especie TEXT NOT NULL, altura TEXT, raiz TEXT,
id_institucion TEXT, FOREIGN KEY (id_institucion) REFERENCES institucion(id_institucion));
